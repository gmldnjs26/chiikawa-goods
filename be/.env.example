# 로컬: TCP 접속 (docker compose)
DB_HOST=localhost
DB_PORT=5433
DB_USER=chiikawa
DB_PASSWORD=chiikawa
DB_NAME=chiikawa
DB_SSL=false

# Cloud SQL: Unix 소켓 마운트. 이 값이 있으면 DB_HOST/DB_PORT는 무시된다
# (docs/tech-stack.md §2.6 — 접속 방식을 환경변수로 추상화)
# DB_SOCKET_PATH=/cloudsql/PROJECT:asia-northeast1:INSTANCE

# 쿼리 로그. 로컬 디버깅용
DB_LOGGING=false

LOG_LEVEL=info
